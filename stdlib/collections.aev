// ----------------------------------------------------------------------------
// set<int>
// ----------------------------------------------------------------------------

struct SetInt { items: int[], slots: int[], size: int, cap: int }

func _set_int_rebuild(s: ref SetInt) {
    s.slots = new int[s.cap];
    let j = 0;
    while (j < s.size) {
        let idx = _collection_hash_int(s.items[j]) % s.cap;
        while (s.slots[idx] != 0) {
            idx = (idx + 1) % s.cap;
        }
        s.slots[idx] = j + 1;
        j = j + 1;
    }
}

func _set_int_rehash(s: ref SetInt, nc: int) {
    let ni = new int[nc];
    let i = 0;
    while (i < s.size) {
        ni[i] = s.items[i];
        i = i + 1;
    }
    s.items = ni;
    s.cap = nc;
    _set_int_rebuild(s);
}

func _set_int_ensure(s: ref SetInt) {
    if ((s.size + 1) * 10 <= s.cap * 7) { return; }
    _set_int_rehash(s, s.cap * 2);
}

func set_int_new() : SetInt {
    let c = 8;
    return SetInt { new int[c], new int[c], 0, c };
}

func set_int_add(s: ref SetInt, value: int) {
    _set_int_ensure(s);
    let idx = _collection_hash_int(value) % s.cap;
    while (s.slots[idx] != 0) {
        let slot = s.slots[idx];
        if (s.items[slot - 1] == value) { return; }
        idx = (idx + 1) % s.cap;
    }
    s.items[s.size] = value;
    s.slots[idx] = s.size + 1;
    s.size = s.size + 1;
}

func set_int_insert(s: ref SetInt, value: int) {
    set_int_add(s, value);
}

func set_int_contains(s: SetInt, value: int) : bool {
    let idx = _collection_hash_int(value) % s.cap;
    let steps = 0;
    while (steps < s.cap) {
        let slot = s.slots[idx];
        if (slot == 0) { return false; }
        if (s.items[slot - 1] == value) { return true; }
        idx = (idx + 1) % s.cap;
        steps = steps + 1;
    }
    return false;
}

func set_int_has(s: SetInt, value: int) : bool {
    return set_int_contains(s, value);
}

func set_int_remove(s: ref SetInt, value: int) {
    let idx = _collection_hash_int(value) % s.cap;
    let steps = 0;
    while (steps < s.cap) {
        let slot = s.slots[idx];
        if (slot == 0) { return; }
        let e = slot - 1;
        if (s.items[e] == value) {
            let j = e;
            while (j + 1 < s.size) {
                s.items[j] = s.items[j + 1];
                j = j + 1;
            }
            s.size = s.size - 1;
            _set_int_rebuild(s);
            return;
        }
        idx = (idx + 1) % s.cap;
        steps = steps + 1;
    }
}

func set_int_delete(s: ref SetInt, value: int) {
    set_int_remove(s, value);
}

func set_int_erase(s: ref SetInt, value: int) {
    set_int_remove(s, value);
}

func set_int_clear(s: ref SetInt) {
    s.size = 0;
    s.slots = new int[s.cap];
}

func set_int_size(s: SetInt) : int { return s.size; }
func set_int_len(s: SetInt) : int { return s.size; }
func set_int_count(s: SetInt) : int { return s.size; }
func set_int_length(s: SetInt) : int { return s.size; }

func set_int_items(s: SetInt) : int[] {
    let out = new int[s.size];
    let i = 0;
    while (i < s.size) { out[i] = s.items[i]; i = i + 1; }
    return out;
}

func set_int_to_array(s: SetInt) : int[] { return set_int_items(s); }

func set_new_int() : SetInt { return set_int_new(); }
func new_set_int() : SetInt { return set_int_new(); }
func create_set_int() : SetInt { return set_int_new(); }

