// std:collections — in-place utilities over int slices.
//
// These are thin loops wrapped so a caller can write `sort_int(a);` instead
// of re-implementing the algorithm. Nothing here allocates beyond what the
// underlying `new`/assignment path already does; all work is in-place on the
// slice's backing memory.

// swaps arr[i] and arr[j].
func _swap_int(arr: int[], i: int, j: int) {
    let t = arr[i];
    arr[i] = arr[j];
    arr[j] = t;
}

// linear scan; returns index or -1.
func index_of_int(arr: int[], value: int) : int {
    let n = len(arr);
    let i = 0;
    while (i < n) {
        if (arr[i] == value) { return i; }
        i = i + 1;
    }
    return -1;
}

func contains_int(arr: int[], value: int) : bool {
    return index_of_int(arr, value) >= 0;
}

func min_int(arr: int[]) : int {
    let n = len(arr);
    if (n <= 0) { exit(1); }
    let m = arr[0];
    let i = 1;
    while (i < n) {
        if (arr[i] < m) { m = arr[i]; }
        i = i + 1;
    }
    return m;
}

func max_int(arr: int[]) : int {
    let n = len(arr);
    if (n <= 0) { exit(1); }
    let m = arr[0];
    let i = 1;
    while (i < n) {
        if (arr[i] > m) { m = arr[i]; }
        i = i + 1;
    }
    return m;
}

// sorts arr in place using insertion sort (small, stable, no recursion).
func sort_int(arr: int[]) {
    let n = len(arr);
    let i = 1;
    while (i < n) {
        let v = arr[i];
        let j = i - 1;
        while (j >= 0 && arr[j] > v) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = v;
        i = i + 1;
    }
}

func reverse_int(arr: int[]) {
    let n = len(arr);
    let i = 0;
    while (i < n / 2) {
        _swap_int(arr, i, n - 1 - i);
        i = i + 1;
    }
}

func sum_int(arr: int[]) : int {
    let n = len(arr);
    let s = 0;
    let i = 0;
    while (i < n) {
        s = s + arr[i];
        i = i + 1;
    }
    return s;
}

// ============================================================================
// ============================================================================
// std:collections — arena-backed monomorphic map/set (v0.3.9)
//
// Open-addressing hash tables. Storage lives on the compilation arena and is
// reclaimed at the next epoch rollback. No generics are available yet, so the
// variants are monomorphic; string keys use the runtime's stable FNV-1a hash.
// ============================================================================

// Stable 32-bit hash for integer keys. The multiply is a classic Fibonacci
// mixing step; taking the absolute value keeps the modulo index non-negative.
func _collection_hash_int(v: int) : int {
    let x = v * 2654435761;
    if (x < 0) { x = -x; }
    // -INT_MIN overflows back to INT_MIN; clamp that one case so the modulo
    // index can never be negative.
    if (x < 0) { x = 1; }
    return x;
}

func _collection_hash_str(s: string) : int {
    return str_hash(s);
}

// ----------------------------------------------------------------------------
// map<int,int>
// ----------------------------------------------------------------------------

struct MapIntInt { keys: int[], vals: int[], slots: int[], size: int, cap: int }

func _map_int_int_rebuild(m: ref MapIntInt) {
    m.slots = new int[m.cap];
    let j = 0;
    while (j < m.size) {
        let idx = _collection_hash_int(m.keys[j]) % m.cap;
        while (m.slots[idx] != 0) {
            idx = (idx + 1) % m.cap;
        }
        m.slots[idx] = j + 1;
        j = j + 1;
    }
}

func _map_int_int_rehash(m: ref MapIntInt, nc: int) {
    let nk = new int[nc];
    let nv = new int[nc];
    let i = 0;
    while (i < m.size) {
        nk[i] = m.keys[i];
        nv[i] = m.vals[i];
        i = i + 1;
    }
    m.keys = nk;
    m.vals = nv;
    m.cap = nc;
    _map_int_int_rebuild(m);
}

func _map_int_int_ensure(m: ref MapIntInt) {
    // Keep the load factor at or below 70%; an empty slot always terminates
    // the probe loop in put().
    if ((m.size + 1) * 10 <= m.cap * 7) { return; }
    _map_int_int_rehash(m, m.cap * 2);
}

func map_int_int_new() : MapIntInt {
    let c = 8;
    return MapIntInt { new int[c], new int[c], new int[c], 0, c };
}

func map_int_int_put(m: ref MapIntInt, key: int, val: int) {
    _map_int_int_ensure(m);
    let idx = _collection_hash_int(key) % m.cap;
    while (m.slots[idx] != 0) {
        let slot = m.slots[idx];
        if (m.keys[slot - 1] == key) {
            m.vals[slot - 1] = val;
            return;
        }
        idx = (idx + 1) % m.cap;
    }
    m.keys[m.size] = key;
    m.vals[m.size] = val;
    m.slots[idx] = m.size + 1;
    m.size = m.size + 1;
}

func map_int_int_set(m: ref MapIntInt, key: int, val: int) {
    map_int_int_put(m, key, val);
}

func map_int_int_add(m: ref MapIntInt, key: int, val: int) {
    map_int_int_put(m, key, val);
}

func map_int_int_insert(m: ref MapIntInt, key: int, val: int) {
    map_int_int_put(m, key, val);
}

func map_int_int_get(m: MapIntInt, key: int) : int {
    let idx = _collection_hash_int(key) % m.cap;
    let steps = 0;
    while (steps < m.cap) {
        let slot = m.slots[idx];
        if (slot == 0) { return 0; }
        if (m.keys[slot - 1] == key) { return m.vals[slot - 1]; }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
    return 0;
}

func map_int_int_lookup(m: MapIntInt, key: int) : int {
    return map_int_int_get(m, key);
}

func map_int_int_find(m: MapIntInt, key: int) : int {
    return map_int_int_get(m, key);
}

func map_int_int_has(m: MapIntInt, key: int) : bool {
    let idx = _collection_hash_int(key) % m.cap;
    let steps = 0;
    while (steps < m.cap) {
        let slot = m.slots[idx];
        if (slot == 0) { return false; }
        if (m.keys[slot - 1] == key) { return true; }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
    return false;
}

func map_int_int_contains(m: MapIntInt, key: int) : bool {
    return map_int_int_has(m, key);
}

func map_int_int_contains_key(m: MapIntInt, key: int) : bool {
    return map_int_int_has(m, key);
}

func map_int_int_remove(m: ref MapIntInt, key: int) {
    let idx = _collection_hash_int(key) % m.cap;
    let steps = 0;
    while (steps < m.cap) {
        let slot = m.slots[idx];
        if (slot == 0) { return; }
        let e = slot - 1;
        if (m.keys[e] == key) {
            let j = e;
            while (j + 1 < m.size) {
                m.keys[j] = m.keys[j + 1];
                m.vals[j] = m.vals[j + 1];
                j = j + 1;
            }
            m.size = m.size - 1;
            _map_int_int_rebuild(m);
            return;
        }
        idx = (idx + 1) % m.cap;
        steps = steps + 1;
    }
}

func map_int_int_delete(m: ref MapIntInt, key: int) {
    map_int_int_remove(m, key);
}

func map_int_int_del(m: ref MapIntInt, key: int) {
    map_int_int_remove(m, key);
}

func map_int_int_erase(m: ref MapIntInt, key: int) {
    map_int_int_remove(m, key);
}

func map_int_int_clear(m: ref MapIntInt) {
    m.size = 0;
    m.slots = new int[m.cap];
}

func map_int_int_size(m: MapIntInt) : int { return m.size; }
func map_int_int_len(m: MapIntInt) : int { return m.size; }
func map_int_int_count(m: MapIntInt) : int { return m.size; }
func map_int_int_length(m: MapIntInt) : int { return m.size; }

func map_int_int_keys(m: MapIntInt) : int[] {
    let out = new int[m.size];
    let i = 0;
    while (i < m.size) { out[i] = m.keys[i]; i = i + 1; }
    return out;
}

func map_int_int_values(m: MapIntInt) : int[] {
    let out = new int[m.size];
    let i = 0;
    while (i < m.size) { out[i] = m.vals[i]; i = i + 1; }
    return out;
}

// alias constructors
func map_new_int_int() : MapIntInt { return map_int_int_new(); }
func new_map_int_int() : MapIntInt { return map_int_int_new(); }
func create_map_int_int() : MapIntInt { return map_int_int_new(); }

