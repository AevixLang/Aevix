// control.aev — if/else, while, break, continue.
hot {
    let i = 0;
    let sum = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) { continue; }
        if (i == 7) { break; }
        sum = sum + i;
    }
    print i;
    print sum;

    if (sum > 20) { print "big"; } else { print "small"; }
}