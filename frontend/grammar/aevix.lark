start: _program
_program: stmt*

stmt: let_stmt
    | hot_block
    | expr_stmt
    | print_stmt
    | if_stmt
    | while_stmt
    | for_stmt
    | return_stmt
    | assign_stmt
    | func_decl

func_decl: "func" CNAME "(" params ")" (":" type_name)? block
params: (param ("," param)*)?
param: CNAME (":" type_name)?

let_stmt: "let" CNAME (":" type_name)? "=" expr ";"
hot_block: "hot" block
expr_stmt: expr ";"
print_stmt: "print" expr ";"
if_stmt: "if" "(" expr ")" block ("else" else_branch)?
else_branch: if_stmt | block
while_stmt: "while" "(" expr ")" block
for_stmt: "for" "(" for_init? ";" expr? ";" for_step? ")" block
for_init: for_let | for_assign | expr
for_let: "let" CNAME (":" type_name)? "=" expr
for_assign: CNAME "=" expr
for_step: for_assign | expr
return_stmt: "return" expr? ";"
assign_stmt: CNAME "=" expr ";"

block: "{" stmt* "}"

// Precedence: or >> and >> comparison >> +- >> */ >> unary(-, !) >> atom
expr: or_
or_: and_ (OROP and_)*
and_: comparision (ANDOP comparision)*
comparision: arith (CMPOP arith)*
arith: term (ADDOP term)*
term: factor (MULOP factor)*
factor: MINUS factor | BANG factor | atom
atom: NUMBER | FLOAT | BOOL | STRING | CNAME call_suffix? | "(" expr ")"
call_suffix: "(" arg_list? ")"
arg_list: expr ("," expr)*

OROP: "||"
ANDOP: "&&"
CMPOP: "==" | "!=" | "<" | ">" | "<=" | ">="

type_name: T_INT | T_FLOAT | T_BOOL | T_STRING
T_INT: "int"
T_FLOAT: "float"
T_BOOL: "bool"
T_STRING: "string"
 
ADDOP: "+" | "-"
MULOP: "*" | "/"
MINUS: "-"
BANG: "!"

BOOL.1: "true" | "false"
STRING: /"[^"]*"/
CNAME: /[a-zA-Z_][a-zA-Z0-9_]*/
NUMBER: /[0-9]+/
FLOAT: /[0-9]+\.[0-9]+/

%ignore " "
%ignore "\n"
%ignore "\r"
%ignore "\t"